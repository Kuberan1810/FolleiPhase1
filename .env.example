# Where the API lives.
#
# Leave this empty for local development: vite.config.ts proxies /api to the
# backend on 127.0.0.1:8000, so the browser stays same-origin.
#
# Set it when the frontend is deployed separately from the API, e.g.
#   VITE_API_BASE_URL=https://api.example.com
# No trailing slash and no /api suffix. The backend must list this frontend's
# origin in FRONTEND_BASE_URL so CORS allows it.
VITE_API_BASE_URL=
