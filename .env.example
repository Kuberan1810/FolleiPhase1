# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# The current backend exposes Gmail OAuth through these paths. If the expanded
# Google Workspace migration is deployed, replace both values with its start
# and connection-list routes without changing frontend code.
VITE_GOOGLE_OAUTH_START_PATH=/api/email-connections/gmail/oauth/start
VITE_GOOGLE_CONNECTIONS_PATH=/api/email-connections
